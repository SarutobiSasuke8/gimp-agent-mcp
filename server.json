{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SarutobiSasuke8/gimp-agent-mcp",
  "title": "GIMP Agent MCP",
  "description": "Edit in GIMP 3 with AI agents: live previews, grouped edits, pixel measurements and recipes.",
  "version": "0.5.0",
  "websiteUrl": "https://pypi.org/project/gimp-agent-mcp/",
  "repository": {
    "url": "https://github.com/SarutobiSasuke8/gimp-agent-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "gimp-agent-mcp",
      "version": "0.5.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "environmentVariables": [
        {
          "name": "GIMP_AGENT_ALLOW_PYTHON",
          "description": "Set to 0 to remove the gimp_run_python tool",
          "format": "string",
          "isRequired": false
        }
      ]
    }
  ]
}
